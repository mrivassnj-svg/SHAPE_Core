    "# ── Print tool metadata — show the 4 tools to camera ─────────────────────\n",
    "from shape.tools import get_tools\n",
    "\n",
    "tools = get_tools(config)\n",
    "print(f\"SHAPE has {len(tools)} integrated tools:\\n\")\n",
    "for i, tool in enumerate(tools, 1):\n",
    "    first_line = tool.description.split(\".\")[0]\n",
    "    print(f\"  {i}. {tool.name:<18} — {first_line}.\")"
   ]
